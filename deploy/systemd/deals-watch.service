[Unit]
Description=LangGraph price watch (Best Buy, Amazon, Newegg, canadadz)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/source/langgraph-workspace
Environment=PYTHONUNBUFFERED=1
# The agent fallback runs `claude` and `npx` (Playwright MCP); a lingering user manager has no login PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --frozen python -m lg_workflows.deals.watch
TimeoutStartSec=40min
Nice=10
