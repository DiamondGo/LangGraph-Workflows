[Unit]
Description=LangGraph daily news digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/source/langgraph-workspace
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/uv run --frozen python -m lg_workflows.news.daily
TimeoutStartSec=20min
Nice=10
