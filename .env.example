# Copy to .env and fill in. .env is gitignored; never commit real values.

# Local OpenAI-compatible server (llama.cpp, vLLM, LiteLLM, ...). Used for bulk work.
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_API_KEY=sk-your-local-key
LOCAL_MODEL=Qwen3.8-Flash-Next

# OpenAI-compatible gateway (e.g. LiteLLM). Used as the "brain" model.
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=sk-your-gateway-key
BRAIN_MODEL=gpt-6.1-sol

# CLI agents authenticate through their own logins; these only pick the model.
CLAUDE_MODEL=claude-sonnet-5-5
AGY_MODEL=gemini-3.8-flash-medium
CURSOR_MODEL=claude-opus-5-5-medium

# Posting news to X through a logged-in Chrome profile: off | dry_run | live
X_POST_MODE=off
# X_CHROME_PROFILE=/path/to/profile   # default: data/x_chrome_profile

# Alerts (e.g. X login expired): comma-separated channels, desktop and/or telegram
NOTIFY_CHANNELS=desktop
# Telegram: create a bot with @BotFather, message it once, then run
#   uv run python -m lg_workflows.notify chat-id
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=lg-workflows
